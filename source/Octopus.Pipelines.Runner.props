<Project>
  <!--
    Shared settings for the Octopus.Pipelines.Runner.* projects. Each runner .csproj imports this explicitly rather
    than relying on a Directory.Build.props, so the rest of the solution's build settings are untouched.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Tentacle's build publishes the whole solution once per runtime (Release-net10.0-<rid>), which needs every project
         it builds restored for that runtime. The same list as Octopus.Tentacle.csproj's net10.0 runtimes. The Native AOT
         executables clear it: they're not part of those builds. -->
    <RuntimeIdentifiers>win-x86;win-x64;linux-x64;osx-x64;osx-arm64;linux-arm64;linux-arm;linux-musl-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
