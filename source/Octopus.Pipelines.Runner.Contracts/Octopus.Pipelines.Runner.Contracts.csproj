<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Octopus.Pipelines.Runner.props" />

  <PropertyGroup>
    <RootNamespace>Octopus.Pipelines.Runner.Contracts</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Client and server stubs. Octopus Server hosts RunnerGatewayBase; the CLI does too, in process (Gateway's
      InProcessCallInvoker). The generated code needs no reflection, so it is trim and Native AOT safe.
    -->
    <Protobuf Include="Protos\runner_gateway.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
