{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Grpc": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "Runner": {
    "ServerAddress": "http://localhost:8081",
    "Token": "",
    "CellId": "local",
    "MaxConcurrentJobs": 100,
    "Backend": "Kubernetes",
    "LogFlushInterval": "00:00:01",
    "LogFlushBytes": 65536,
    "Kubernetes": {
      "Namespace": "poc-jobs",
      "JobImage": "busybox:1.37",
      "CpuRequest": "10m",
      "MemoryRequest": "16Mi",
      "MemoryLimit": "32Mi",
      "CpuLimit": "250m",
      "EphemeralStorageRequest": "8Mi",
      "EphemeralStorageLimit": "64Mi",
      "UserNamespaces": true,
      "MaxParallelPodCreates": 20,
      "PodStartTimeout": "00:15:00",
      "Steps": {
        "StepRunnerImage": "octopus/pipelines-step-runner:dev",
        "ClaimName": null,
        "HostPath": null,
        "LocalPath": "/octopus-shared"
      }
    }
  }
}
